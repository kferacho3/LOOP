# LOOP • fill values locally, then add them separately in Vercel.
# Do not commit .env. Defaults deliberately do NOT send email or accept donations.

# CONFIG — non-secret. Replace with the approved canonical HTTPS domain.
SITE_URL=http://localhost:3000
# Keep false until content, privacy notice, contacts and service coverage are approved.
SITE_READY=false
FORMS_ENABLED=false
# Public contact details; leave blank rather than invent details.
CONTACT_EMAIL=
CONTACT_PHONE=
# Approved hosted donation page, HTTPS only. No payment credentials needed.
DONATION_URL=
# Set only an exact official site's origin. Optional approved social links.
INSTAGRAM_URL=
FACEBOOK_URL=
LINKEDIN_URL=

# SECRET — Resend. Use a verified domain for FORM_FROM_EMAIL.
RESEND_API_KEY=
# CONFIG — destination inbox and verified sender (not API secrets).
FORM_TO_EMAIL=
FORM_FROM_EMAIL=

# SECRET — Pexels key is used only by the local editorial search script.
PEXELS_API_KEY=

# CONFIG — Cloudflare Turnstile public site key. Required for production forms.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# SECRET — never prefix this with NEXT_PUBLIC_.
TURNSTILE_SECRET_KEY=

# CONFIG — Upstash Redis REST URL; SECRET — token and a random 32+ character salt.
# Required when live production forms are enabled; shared rate limits fail closed.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_SALT=

# CONFIG — optional Sanity public-content dataset. Site works without a CMS.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2025-02-19
# SECRET — optional read-only token, only for a PRIVATE dataset.
SANITY_API_READ_TOKEN=
# CONFIG — no analytics until explicitly enabled. Never track support forms.
NEXT_PUBLIC_ENABLE_ANALYTICS=false
