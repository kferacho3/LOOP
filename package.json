{
  "name": "loop-community",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/unit.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "media:search": "node --env-file=.env scripts/pexels-search.mjs",
    "media:download": "node --env-file=.env scripts/download-media.mjs",
    "verify:launch": "node --env-file=.env scripts/verify-launch.mjs",
    "studio:dev": "npm --prefix studio run dev",
    "studio:build": "npm --prefix studio run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "gsap": "3.13.0",
    "lucide-react": "0.468.0",
    "server-only": "0.0.1",
    "@vercel/analytics": "1.5.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.15.30",
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.4",
    "tailwindcss": "4.1.18",
    "@tailwindcss/postcss": "4.1.18",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.6",
    "@playwright/test": "1.57.0",
    "@axe-core/playwright": "4.10.2",
    "prettier": "3.6.2"
  },
  "type": "module"
}
